import { useState } from "react";
import { Link, useParams } from "react-router-dom";
import { Search, UserCheck, Shield, GitCompareArrows, FlaskConical, Clock } from "lucide-react";
import { PageHeader } from "@shared/components/PageHeader";
import { Card, CardBody, CardHeader, Input, Button, Badge, Label } from "@shared/components/ui";
import { DataTable } from "@shared/components/DataTable";
import { useDirectoryQuery } from "@shared/api/instanceApi";
import { useMyEffectiveAccessQuery } from "@shared/api/instanceApi";
import { useEffectiveAccessQuery } from "@shared/api/instanceApi";
import { useDebounce } from "@shared/hooks/useDebounce";
import { formatDate } from "@shared/lib/format";
import { PermissionGate } from "@shared/components/PermissionGate";
import { PERMISSIONS } from "@shared/authorization/permissions";
import { useAppSelector } from "@shared/store/hooks";
import { selectPermissions } from "@shared/auth/authSlice";
import type { DirectoryUser, EffectiveAccessResponse } from "@shared/types";

export function EffectiveAccessPage() {
  const { instanceId = "" } = useParams<{ instanceId: string }>();
  const [selectedUserId, setSelectedUserId] = useState("");
  const [activeTab, setActiveTab] = useState("viewer");
  const [search, setSearch] = useState("");
  const debouncedSearch = useDebounce(search, 300);
  const { data: directory } = useDirectoryQuery({ instanceId, limit: 50 }, { skip: !instanceId });
  const permissions = useAppSelector(selectPermissions);
  const canViewAll = permissions.includes("*") || permissions.includes(PERMISSIONS.tenantUserRead);

  const myAccess = useMyEffectiveAccessQuery(instanceId, { skip: !instanceId });
  const selectedAccess = useEffectiveAccessQuery(
    { instanceId, userId: selectedUserId },
    { skip: !instanceId || !selectedUserId },
  );

  const users = directory?.items ?? [];

  const tabs = [
    { id: "viewer", label: "User Access Viewer", icon: <UserCheck className="h-3.5 w-3.5" /> },
    { id: "simulator", label: "Authorization Simulator", icon: <FlaskConical className="h-3.5 w-3.5" /> },
    { id: "comparison", label: "Role Comparison", icon: <GitCompareArrows className="h-3.5 w-5" /> },
  ];

  return (
    <div>
      <PageHeader
        title="Effective Access"
        description="View, simulate, and compare effective access across users and roles."
        breadcrumbs={<Link to={`/instances/${instanceId}`} className="hover:text-brand-600">Instance</Link>}
      />
      <Card className="mb-4">
        <CardBody>
          <div className="flex flex-wrap items-center gap-3">
            <select value={selectedUserId} onChange={(e) => setSelectedUserId(e.target.value)} className="focus-ring rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
              <option value="">Select a user…</option>
              {users.map((user: DirectoryUser) => (
                <option key={user._id} value={user._id}>{user.name}</option>
              ))}
            </select>
            <div className="flex gap-1">
              {tabs.map((tab) => (
                <button key={tab.id} onClick={() => setActiveTab(tab.id)} className={`rounded-md px-3 py-2 text-sm font-medium ${activeTab === tab.id ? "bg-brand-600 text-white" : "text-slate-600 hover:bg-slate-100"}`}>{tab.label}</button>
              ))}
            </div>
          </div>
        </CardBody>
      </Card>
      {activeTab === "viewer" && (
        <Card>
          <CardHeader title="User Access Viewer" />
          <CardBody>
            {selectedUserId ? selectedAccess.isLoading ? <p className="py-8 text-center text-sm text-slate-500">Loading access…</p> : selectedAccess.isError ? <p className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">Could not load access.</p> : (
              <div className="space-y-4">
                <div><p className="text-sm font-semibold">{(selectedAccess.data as EffectiveAccessResponse)?.name}</p><p className="text-xs text-slate-500">{(selectedAccess.data as EffectiveAccessResponse)?.email}</p></div>
                <div className="grid gap-4 md:grid-cols-2">
                  <Card><CardHeader title="Effective Permissions" /><CardBody><div className="flex flex-wrap gap-1.5">{(selectedAccess.data as EffectiveAccessResponse)?.effective?.length ? (selectedAccess.data as EffectiveAccessResponse).effective.map((grant: string) => <Badge key={grant} variant="success">{grant}</Badge>) : <span className="text-xs text-slate-400">—</span>}</div></CardBody></Card>
                  <Card><CardHeader title="Denied Permissions" /><CardBody><div className="flex flex-wrap gap-1.5">{(selectedAccess.data as EffectiveAccessResponse)?.denied?.length ? (selectedAccess.data as EffectiveAccessResponse).denied.map((grant: string) => <Badge key={grant} variant="danger">{grant}</Badge>) : <span className="text-xs text-slate-400">—</span>}</div></CardBody></Card>
                </div>
                <Card><CardHeader title="Sources" /><CardBody><div className="space-y-1">{Object.entries((selectedAccess.data as EffectiveAccessResponse)?.sources ?? {}).map(([key, value]) => <div key={key} className="flex justify-between text-sm"><span className="text-slate-500">{key}</span><span className="font-medium">{String(value)}</span></div>)}</div></CardBody></Card>
              </div>
            )}
          </CardBody>
        </Card>
      )}
      {activeTab === "simulator" && (
        <Card>
          <CardHeader title="Authorization Simulator" description="Simulate what permissions a role or user would have." />
          <CardBody>
            <div className="space-y-4">
              <div className="grid gap-4 md:grid-cols-2">
                <div><Label>Role to simulate</Label><select className="focus-ring w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><option>— Select a role —</option></select></div>
                <div><Label>Permission to check</Label><input placeholder="e.g., itsm.incident.read" className="focus-ring w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" /></div>
              </div>
              <div className="rounded-lg border border-slate-200 bg-slate-50 p-4"><p className="text-sm text-slate-600">Select a role and permission to see the simulation result.</p></div>
            </div>
          </CardBody>
        </Card>
      )}
      {activeTab === "comparison" && (
        <Card>
          <CardHeader title="Role Comparison" description="Compare permissions between two roles." />
          <CardBody>
            <div className="grid gap-4 md:grid-cols-2">
              <div><Label>Role A</Label><select className="focus-ring w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><option>— Select role A —</option></select></div>
              <div><Label>Role B</Label><select className="focus-ring w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><option>— Select role B —</option></select></div>
            </div>
            <div className="mt-4 overflow-x-auto">
              <table className="w-full text-sm"><thead className="bg-slate-50"><tr><th className="px-4 py-3 text-left">Permission</th><th className="px-4 py-3 text-center">Role A</th><th className="px-4 py-3 text-center">Role B</th></tr></thead><tbody><tr><td className="px-4 py-3">itsm.incident.read</td><td className="px-4 py-3 text-center"><Badge variant="success">Yes</Badge></td><td className="px-4 py-3 text-center"><Badge variant="danger">No</Badge></td></tr></tbody></table>
            </div>
          </CardBody>
        </Card>
      )}
    </div>
  );
}


